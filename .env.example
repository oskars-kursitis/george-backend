OPENAI_API_KEY=sk-your-key-here
PORT=3000

# Shared secret the app sends as x-george-key. Leave unset only for local dev.
GEORGE_API_KEY=

# Comma-separated browser origins. Mobile clients send no Origin and are unaffected.
ALLOWED_ORIGINS=

# Absolute base URL used when handing out image links (needed behind a proxy).
PUBLIC_BASE_URL=

# Model overrides (defaults are current as of September 2026)
GEORGE_CONCEPT_MODEL=gpt-image-2.5-flare
GEORGE_SPEC_MODEL=gpt-image-2.5-sunburst
GEORGE_VISION_MODEL=gpt-5.6-luna
